# Ejemplo SOLO para instancia sintética propia. No cargar en Pruebas pública.
KARTA3_ENV=test
KARTA3_USAGE_COLLECTION=off
# Ruta absoluta privada fuera de dist/barajas/public. Subdirectorio test automático.
KARTA3_USAGE_DIRECTORY=/var/lib/karta3/usage
# Copias opcionales en esta prueba; preparar clave AES-256 de 64 hex en fichero
# privado fuera de Git. Configuración y copias se separan por entorno.
KARTA3_USAGE_BACKUP_KEY_FILE=
# No pegar una clave real en este ejemplo. Nunca una credencial de juego.
