# B21: ejemplo inerte local; no aplicar al VPS ni activar sin encargo operativo.
KARTA3_ENV=pruebas
KARTA3_STATISTICS_MODE=off
KARTA3_STATISTICS_DIRECTORY=/var/lib/karta3/statistics
# Clave existente privada fuera de Git; no pegar su valor.
KARTA3_STATISTICS_BACKUP_KEY_PATH=/ruta/privada/statistics-backup.key
# Inicializar explícitamente el archivo nuevo mediante usage:initialize.
# No usar usage.sqlite, migradores ni los volúmenes antiguos.
