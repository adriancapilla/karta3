# B19: configuración preparada, OFF por defecto. No aplicar al VPS sin autorización.
KARTA3_ENV=pruebas
KARTA3_USAGE_COLLECTION=off
# Ruta absoluta privada fuera de dist/barajas/public. Subdirectorio test automático.
KARTA3_USAGE_DIRECTORY=/var/lib/karta3/usage
# HUMAN solo admite Pruebas y archivo privado; no una clave literal en variables.
# Utilizar compose.usage-key.yaml para montar el archivo existente como secreto RO.
KARTA3_USAGE_BACKUP_KEY_PATH=/ruta/privada/usage-backup.key
# No pegar una clave real en este ejemplo. Nunca una credencial de juego.
