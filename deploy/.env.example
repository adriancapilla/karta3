COMPOSE_PROJECT_NAME=karta3-pruebas
KARTA3_ENV=pruebas
KARTA3_DOMAIN=pruebas.karta3.com
# Pruebas es un servicio HTTPS compilado: conservar production para cookies Secure.
NODE_ENV=production
# Completar con la referencia entregada por GitHub, por ejemplo:
# ghcr.io/PROPIETARIO/karta3@sha256:DIGEST_COMPROBADO
KARTA3_IMAGE=
CADDY_IMAGE=caddy:2.11.7-alpine@sha256:d8542f48d34a9cf4e4c11a478865229840e87e4c96ea3f439101f31a5d35f75f
# No claves SSH, tokens del registro ni credenciales administrativas aquí.
# APP no requiere actualmente un secreto de configuración. Si un parámetro privado
# es consumido por APP, suministrarlo en .env.private (ignorado) al arrancar.
