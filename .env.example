# Puerto HTTP del servidor; Vite usa 5173 en desarrollo.
PORT=3000
# Dirección de escucha local; Docker suministra 0.0.0.0 por su red interna.
HOST=127.0.0.1
# Solo en producción, detrás de HTTPS/Caddy.
NODE_ENV=development
# Entorno administrativo independiente de NODE_ENV. Recogida pública apagada.
KARTA3_ENV=development
KARTA3_USAGE_COLLECTION=off
# Opcionales, rutas absolutas privadas fuera del estático. No incluir claves aquí.
KARTA3_USAGE_DIRECTORY=
KARTA3_USAGE_BACKUP_KEY_FILE=
