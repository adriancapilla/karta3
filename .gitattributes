* text=auto eol=lf
# Copias aprobadas: conservar todos los bytes, también al clonar en Windows.
barajas/** -text whitespace=cr-at-eol
# Certificados recibidos B15: sus huellas identifican bytes, no JSON reserializado.
docs/sdd/evidencias/B15/MANIFIESTO_SHA256.json -text whitespace=cr-at-eol
docs/sdd/evidencias/B15/DELTA_3_A_4.json -text whitespace=cr-at-eol
docs/sdd/evidencias/B15/REGISTRO_ACTIVACION.md -text whitespace=cr-at-eol
# Certificados originales de entrega B16: conservar bytes y finales de línea.
docs/sdd/evidencias/B16/certificados/** -text whitespace=cr-at-eol
# Certificados finales B22: conservar bytes aprobados.
docs/sdd/evidencias/B22/certificados/** -text whitespace=cr-at-eol
