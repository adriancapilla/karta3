{
  "name": "karta3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "predev": "npm run decks:prepare",
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/main.ts",
    "dev:client": "vite --host 127.0.0.1",
    "build": "npm run decks:prepare && tsc -b && vite build",
    "decks:validate": "tsx tools/decks.ts validate",
    "decks:prepare": "tsx tools/decks.ts prepare",
    "start": "node dist-server/server/main.js",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:browser": "npm run build && playwright test",
    "lint": "eslint .",
    "check:architecture": "node tools/check-architecture.mjs",
    "check": "npm run typecheck && npm run lint && npm run build && npm run test && npm run check:architecture"
  },
  "dependencies": {
    "cookie": "2.0.1",
    "express": "5.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
